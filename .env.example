# OmicsPrism Platform environment variables.
# Copy this file to .env and change secrets before deployment.

# PostgreSQL
POSTGRES_PASSWORD=omicsprism_prod_2024

# MinIO
MINIO_USER=minioadmin
MINIO_PASSWORD=changeme_minio_password

# Development login. Replace before exposing the service.
DEV_EMAIL=admin@omicsprism.local
DEV_PASSWORD=changeme

# Logging
LOG_LEVEL=INFO

# Backend API host port.
# Keep 127.0.0.1 when nginx runs on the same host. Use 0.0.0.0 only when a
# reverse proxy on another host must connect to this port.
API_BIND_HOST=127.0.0.1
API_PORT=18086

# Static frontend deployment paths.
# Build the frontend with these values, then serve frontend/dist from the host nginx.
PUBLIC_BASE_PATH=/omicsprism/
API_BASE_PATH=/omicsprism/api

# Job history cleanup
JOB_HISTORY_TTL_HOURS=24
HOUSEKEEPING_INTERVAL_SECONDS=3600
