# Copy to omicsprism-platform/.env.agent on the compute server.
# Replace every placeholder and keep the resulting file out of Git.

OMICS_PRISM_STORAGE_BACKEND=postgres
OMICS_PRISM_RUNTIME_DATABASE_URL=postgresql://omics_app:<runtime-password>@<cloud-host>:15432/omicsprism

OMICS_PRISM_EXECUTOR=redis
OMICS_PRISM_REDIS_URL=redis://<cloud-host>:16379/0
OMICS_PRISM_REDIS_QUEUE=omicsprism:jobs

OMICS_PRISM_FILE_STORAGE_BACKEND=s3
OMICS_PRISM_S3_ENDPOINT_URL=http://<cloud-host>:19000
OMICS_PRISM_S3_REGION=us-east-1
OMICS_PRISM_S3_ACCESS_KEY_ID=<minio-access-key>
OMICS_PRISM_S3_SECRET_ACCESS_KEY=<minio-secret-key>
OMICS_PRISM_FILE_STORAGE_BUCKET=omicsprism
OMICS_PRISM_FILE_STORAGE_PREFIX=jobs

OMICS_PRISM_RUNS_DIR=/app/data/runs
OMICS_PRISM_FILE_STORAGE_ROOT=/app/data/storage
OMICS_PRISM_JOB_HISTORY_TTL_HOURS=24
OMICS_PRISM_LOG_LEVEL=INFO

# network_mode=host makes the compute server's loopback vLLM endpoint available.
OMICS_PRISM_AGENT_MODEL_URL=http://127.0.0.1:18000
OMICS_PRISM_AGENT_MODEL_NAME=Qwen3-14B-AWQ
OMICS_PRISM_AGENT_MODEL_API_KEY=
OMICS_PRISM_AGENT_TURN_TIMEOUT_SECONDS=90
OMICS_PRISM_AGENT_LEASE_SECONDS=120
OMICS_PRISM_AGENT_MAX_ATTEMPTS=3
OMICS_PRISM_AGENT_POLL_SECONDS=1
